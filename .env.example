# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=your-api-key-here

# Optional: override the models used by each step.
# TALK_NOTES_WATCH_MODEL=google:gemini-4-argon
# TALK_NOTES_ENRICH_MODEL=google:gemini-3.5-flash-lite

# Optional: hide Pydantic AI's startup banner.
PYDANTIC_AI_NO_BANNER=1
